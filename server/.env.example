PORT=4000
# Interfaz donde escucha (0.0.0.0 = todas; o la IP interna, ej. 172.25.1.3)
HOST=0.0.0.0
# Carpeta del frontend compilado (por defecto ../CalceMasCobranza/dist)
FRONTEND_DIST=
# Origenes extra permitidos por CORS, separados por coma (front y API van en el mismo origen)
CORS_ORIGINS=http://localhost:3000
DB_IP_INTERNA=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=1433
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_EMAIL=
EMAIL_PASSWORD=
EMAIL_TO=
JWT_SECRET=

# Cierre automático de cobranzas (todos los días 23:45, America/Asuncion)
# idCobrador separados por coma: Juan Gabriel (completar), Osvaldo Adrian (142)
CIERRE_AUTOMATICO_COBRADORES=142
# Poner en false para deshabilitarlo
CIERRE_AUTOMATICO_HABILITADO=true
